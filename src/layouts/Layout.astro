---

export interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="GlassNet - A beautiful Frutiger Aero experience" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
    <title>{title}</title>
    <script>
      // @ts-ignore - analytics helper attached to window at runtime
      window.va = window.va || function () { (window.vaq = window.vaq || []).push(arguments); };
    </script>
    <script defer src="/_vercel/insights/script.js"></script>
  </head>
  <body class="gradient-bg">


    <!-- Reduced background bubbles for better performance -->
    <div class="fixed inset-0 pointer-events-none overflow-hidden" id="background-bubbles">
      <div class="bubble w-32 h-32 top-20 left-20" style="animation-delay: 0s;" data-speed="-0.5"></div>
      <div class="bubble bubble-slow w-24 h-24 top-40 right-32" style="animation-delay: 3s;" data-speed="0.8"></div>
      <div class="bubble w-28 h-28 bottom-20 right-20" style="animation-delay: 6s;" data-speed="-0.3"></div>
    </div>



    <!-- Main Content -->
    <main>
      <slot />
    </main>

    <!-- Footer -->
    <footer class="absolute bottom-0 left-0 right-0 z-50 py-4 fade-in-footer">
      <div class="text-center">
        <p class="text-white/80 font-mono text-sm shimmer-glass font-medium">
          HUNTER BASTIAN @ 2025 | MINISITE I
        </p>
      </div>
    </footer>

    <!-- Animation and Parallax Scripts -->
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        // 1. Fade-in animations
        const heroSection = document.querySelector('.fade-in-section');
        const footer = document.querySelector('.fade-in-footer');
        
        if (heroSection instanceof HTMLElement) {
          heroSection.style.opacity = '0';
          heroSection.style.animation = 'fadeInUp 1.2s ease-out 0.5s forwards';
        }
        
        if (footer instanceof HTMLElement) {
          footer.style.opacity = '0';
          // Start footer animation after hero
          footer.style.animation = 'fadeInUp 1.0s ease-out 2.2s forwards';
        }

        // 2. Parallax Effect
        const handleParallax = (e: MouseEvent) => {
          const x = (e.clientX - window.innerWidth / 2) / 50;
          const y = (e.clientY - window.innerHeight / 2) / 50;

          // Select all elements with data-speed attribute
          const parallaxElements = document.querySelectorAll('[data-speed]');

          parallaxElements.forEach((el) => {
            if (el instanceof HTMLElement) {
              const speed = parseFloat(el.getAttribute('data-speed') || '0');
              // Use 'translate' property which is independent of 'transform' (animations)
              // Inverting x/y for a more natural "depth" feel usually
              el.style.translate = `${x * speed}px ${y * speed}px`;
            }
          });
        };

        // Add event listener for mouse movement
        // Throttling could be added here if performance issues arise, but modern browsers handle this well
        window.addEventListener('mousemove', handleParallax);

        // 3. Smooth Scroll Bounce (Optimized)
        let scrollTimeout: ReturnType<typeof setTimeout> | undefined;
        let isScrolling = false;
        let lastScrollTime = 0;

        const handleScroll = () => {
          const now = Date.now();
          if (now - lastScrollTime < 100) return;
          lastScrollTime = now;

          if (!isScrolling) {
            isScrolling = true;
            clearTimeout(scrollTimeout);
            
            scrollTimeout = setTimeout(() => {
              window.scrollTo({
                top: 0,
                left: 0,
                behavior: 'smooth'
              });
              isScrolling = false;
            }, 200);
          }
        };

        window.addEventListener('scroll', handleScroll, { passive: true });
      });
    </script>
  </body>
</html>

<style>
  /* Import global styles */
  @import '../styles/global.css';
  
  /* Shimmer effect for footer */
  @keyframes shimmer {
    0% { transform: translateX(-100%) skewX(-15deg); }
    100% { transform: translateX(200%) skewX(-15deg); }
  }
  
  .shimmer-glass {
    position: relative;
    overflow: hidden;
    transition: all 0.3s ease;
    display: inline-block;
    padding: 6px 12px;
    border-radius: 8px;
    background: rgba(255,255,255,0.1);
    border: 1px solid rgba(255,255,255,0.2);
  }
  
  .shimmer-glass::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.4),
      transparent
    );
    transform: translateX(-100%) skewX(-15deg);
    transition: transform 0.6s;
    pointer-events: none;
    z-index: 1;
  }
  
  .shimmer-glass:hover::before {
    animation: shimmer 0.6s ease-out;
  }
  
  .shimmer-glass:hover {
    transform: scale(1.05);
    box-shadow: 0 0 15px rgba(255, 255, 255, 0.4);
    background: rgba(255,255,255,0.2);
  }
</style>
