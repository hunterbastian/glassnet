---
// Simple 3D Galaxy Visualization Component
---

<div id="galaxy-container" class="fixed inset-0 -z-10 pointer-events-none">
  <canvas id="galaxy-canvas"></canvas>
</div>

<script>
  const canvas = document.getElementById('galaxy-canvas') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;

  let width = window.innerWidth;
  let height = window.innerHeight;

  canvas.width = width;
  canvas.height = height;

  // Galaxy parameters
  const centerX = width / 2;
  const centerY = height / 2;
  const numStars = 1500;
  const numArms = 3;
  let rotation = 0;

  interface Star {
    angle: number;
    distance: number;
    armOffset: number;
    size: number;
    speed: number;
    brightness: number;
    z: number; // depth for 3D effect
    color: string;
  }

  const stars: Star[] = [];

  // Initialize stars
  for (let i = 0; i < numStars; i++) {
    const distance = Math.random() * Math.min(width, height) * 0.4;
    const armIndex = Math.floor(Math.random() * numArms);
    const armAngle = (armIndex * 2 * Math.PI) / numArms;
    const spiralTightness = 3;
    const angle = armAngle + (distance / 100) * spiralTightness + (Math.random() - 0.5) * 0.5;

    // Color variation - blue to white to purple
    const colorTypes = [
      'rgba(147, 197, 253, ', // blue
      'rgba(255, 255, 255, ', // white
      'rgba(196, 181, 253, ', // purple
      'rgba(167, 243, 208, ', // cyan
    ];
    const color = colorTypes[Math.floor(Math.random() * colorTypes.length)];

    stars.push({
      angle,
      distance,
      armOffset: (Math.random() - 0.5) * 30,
      size: Math.random() * 1.5 + 0.5,
      speed: Math.random() * 0.0005 + 0.0002,
      brightness: Math.random() * 0.5 + 0.5,
      z: Math.random() * 200 - 100, // depth
      color
    });
  }

  function drawGalaxy() {
    // Clear with subtle fade for trail effect
    ctx.fillStyle = 'rgba(0, 0, 0, 0.05)';
    ctx.fillRect(0, 0, width, height);

    // Sort stars by z-index for depth
    const sortedStars = [...stars].sort((a, b) => a.z - b.z);

    // Draw stars
    sortedStars.forEach(star => {
      // Calculate 3D position
      const scale = 300 / (300 + star.z);
      const x = centerX + Math.cos(star.angle + rotation) * (star.distance + star.armOffset) * scale;
      const y = centerY + Math.sin(star.angle + rotation) * (star.distance + star.armOffset) * scale * 0.7; // flatten for galaxy disk

      // Skip if out of bounds
      if (x < -50 || x > width + 50 || y < -50 || y > height + 50) return;

      // Size and brightness based on depth
      const size = star.size * scale;
      const brightness = star.brightness * (0.3 + scale * 0.7);

      // Draw star with glow
      ctx.beginPath();

      // Outer glow
      const gradient = ctx.createRadialGradient(x, y, 0, x, y, size * 3);
      gradient.addColorStop(0, star.color + brightness + ')');
      gradient.addColorStop(0.5, star.color + (brightness * 0.3) + ')');
      gradient.addColorStop(1, 'rgba(0, 0, 0, 0)');

      ctx.fillStyle = gradient;
      ctx.arc(x, y, size * 3, 0, Math.PI * 2);
      ctx.fill();

      // Core star
      ctx.beginPath();
      ctx.fillStyle = star.color + brightness + ')';
      ctx.arc(x, y, size, 0, Math.PI * 2);
      ctx.fill();

      // Update star rotation
      star.angle += star.speed;

      // Subtle z-axis movement
      star.z += Math.sin(Date.now() * 0.001 + star.angle) * 0.1;
      star.z = Math.max(-100, Math.min(100, star.z));
    });

    // Rotate galaxy
    rotation += 0.0002;

    requestAnimationFrame(drawGalaxy);
  }

  // Handle window resize
  window.addEventListener('resize', () => {
    width = window.innerWidth;
    height = window.innerHeight;
    canvas.width = width;
    canvas.height = height;
  });

  // Start animation
  drawGalaxy();
</script>

<style>
  #galaxy-container {
    background: transparent;
  }

  #galaxy-canvas {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>
